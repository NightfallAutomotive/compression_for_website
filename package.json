{
  "name": "compression-for-website",
  "version": "1.4.0",
  "description": "JavaScript image compressor for the web.",
  "main": "dist/compressor.common.js",
  "module": "dist/compressor.mjs",
  "browser": "dist/compressor.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/compressor.mjs",
      "require": "./dist/compressor.common.js",
      "default": "./dist/compressor.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "types"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "del-cli dist",
    "dev": "rollup -c -m -w",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:css": "stylelint \"docs/**/*.css\" --fix",
    "lint:js": "eslint --fix",
    "prepare": "simple-git-hooks",
    "release": "npm run clean && npm run lint && npm run build && npm test",
    "start": "npm run dev",
    "test": "web-test-runner"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightfallAutomotive/compression_for_website.git"
  },
  "keywords": [
    "image",
    "compress",
    "compressor",
    "image-compressor",
    "lossy-compression",
    "javascript",
    "front-end",
    "web"
  ],
  "author": "Robert Remblance",
  "contributors": [
    {
      "name": "Chen Fengyuan",
      "url": "https://chenfengyuan.com/"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NightfallAutomotive/compression_for_website/issues"
  },
  "homepage": "https://github.com/NightfallAutomotive/compression_for_website#readme",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,mjs}": "eslint --fix",
    "{src,docs}/**/*.css": "stylelint --fix --allow-empty-input"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-puppeteer": "^1.0.1",
    "chai": "^6.3.0",
    "del-cli": "^8.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "rollup": "^4.64.7",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2"
  },
  "allowScripts": {
    "puppeteer@25.14.0": true,
    "simple-git-hooks@2.14.0": true
  }
}
